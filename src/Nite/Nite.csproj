<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Nite</RootNamespace>
    <Description>Run TypeScript, JSX and React islands from ASP.NET Core without a Node.js toolchain.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Runs PostCSS, Tailwind and Less, which are plain JavaScript, without Node. -->
    <PackageReference Include="Jint" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Runtime\*.js" LogicalName="Nite.Runtime.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Css\*.js" LogicalName="Nite.Css.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nite.Tests" />
  </ItemGroup>

  <!--
    Log messages are Markdown files in Diagnostics/, compiled by Nite.Diagnostics into internal
    Nite.Log methods; the docs site publishes the same files. The generator is a build-time tool:
    PrivateAssets keeps it out of the Nite package's dependencies.
  -->
  <PropertyGroup>
    <NiteDiagnosticsHelpUrl>https://nitefx.dev/docs/reference/diagnostics/{code}.html</NiteDiagnosticsHelpUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nite.Diagnostics\Nite.Diagnostics.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\Nite.Diagnostics\build\Nite.Diagnostics.targets" />

  <ItemGroup>
    <!-- NuGet imports build/<PackageId>.targets into consuming projects automatically. -->
    <None Include="..\..\build\Nite.targets" Pack="true" PackagePath="build\Nite.targets" Visible="false" />
  </ItemGroup>

</Project>
