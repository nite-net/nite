{
  "$schema": "http://json.schemastore.org/template",
  "author": "Tim McQueen",
  "classifications": [
    "Web",
    "SPA",
    "React",
    "TypeScript"
  ],
  "identity": "Nite.Templates.Spa",
  "groupIdentity": "Nite.Spa",
  "name": "NiteFx React SPA",
  "description": "A React single-page app compiled by NiteFx, served next to a minimal API from one ASP.NET Core project. No Node.js toolchain.",
  "shortName": "nite-spa",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "NiteApp",
  "preferNameDirectory": true,
  "defaultName": "NiteApp",
  "symbols": {
    "title": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "NITE_TITLE"
    },
    "namespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace",
      "replaces": "NITE_NAMESPACE"
    },
    "port": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5100,
        "high": 5900
      },
      "replaces": "NITE_PORT"
    },
    "niteVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "NITE_PACKAGE_VERSION"
      },
      "replaces": "NITE_VERSION"
    }
  },
  "primaryOutputs": [
    {
      "path": "NiteApp.csproj"
    }
  ],
  "postActions": [
    {
      "description": "How to run the app",
      "manualInstructions": [
        {
          "text": "Run 'nite watch' in the project folder. The first run installs the packages in nite.json. Needs the nite tool: dotnet tool install --global Nite.Cli"
        }
      ],
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true
    }
  ]
}
