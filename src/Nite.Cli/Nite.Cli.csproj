<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not "nite": assembly names are case-insensitive, so it would shadow Nite.dll. -->
    <AssemblyName>Nite.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nite</ToolCommandName>
    <PackageId>Nite.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nite.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dotnet new templates are also what `nite init` writes. -->
    <EmbeddedResource Include="..\Nite.Templates\content\**\*"
                      Exclude="..\Nite.Templates\content\**\.template.config\**;..\Nite.Templates\content\**\bin\**;..\Nite.Templates\content\**\obj\**;..\Nite.Templates\content\**\node_modules\**"
                      LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nite\Nite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

</Project>
