<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      One build per supported runtime, so the tool package carries tools/net10.0 and tools/net11.0
      and runs on a machine that has only one of them. A .NET 10 SDK cannot target net11.0, so it
      builds net10.0 alone; CI and releases use the .NET 11 SDK and build both. RollForward lets the
      tool start on a later major runtime (.NET 12) before Nite targets it, and on .NET 11 when a
      .NET 10 SDK packed it.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not "nite": assembly names are case-insensitive, so it would shadow Nite.dll. -->
    <AssemblyName>Nite.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nite</ToolCommandName>
    <PackageId>Nite.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nite.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dotnet new templates are also what `nite init` writes. -->
    <EmbeddedResource Include="..\Nite.Templates\content\**\*"
                      Exclude="..\Nite.Templates\content\**\.template.config\**;..\Nite.Templates\content\**\bin\**;..\Nite.Templates\content\**\obj\**;..\Nite.Templates\content\**\node_modules\**"
                      LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nite\Nite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

</Project>
