<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not "nite": assembly names are case-insensitive, so it would shadow Nite.dll. -->
    <AssemblyName>Nite.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nite</ToolCommandName>
    <PackageId>Nite.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nite\Nite.csproj" />
  </ItemGroup>

</Project>
