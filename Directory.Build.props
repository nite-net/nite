<Project>
  <!-- Shared by every project in the repository. Bump Version here when tagging a release. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Tim McQueen</Authors>
    <RepositoryUrl>https://github.com/tmcqueen/nite</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)docs/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
