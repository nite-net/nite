<Project>
  <!-- Shared by every project in the repository. -->
  <PropertyGroup>
    <!--
      Local builds only. CI sets the version from the release tag (v0.6.0 builds 0.6.0) or, for
      other builds, the next patch after the newest tag (0.6.1-ci.42). There is nothing to bump.
    -->
    <Version>0.0.0-dev</Version>
    <!-- One product name on every signed file, as SignPath's terms require. -->
    <Product>NiteFx</Product>
    <Authors>Tim McQueen</Authors>
    <Copyright>Copyright Tim McQueen</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://nitefx.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nite-net/nite</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)docs/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
