{
  // Editor and type-checking settings only. Nite compiles with esbuild, which strips types
  // without checking them (as Vite does); run `tsc --noEmit` in CI if you want the check.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
