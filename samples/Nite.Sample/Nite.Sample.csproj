<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nite\Nite.csproj" />
    <!-- Built first so the Release build can run `nite build`; not referenced as an assembly. -->
    <ProjectReference Include="..\..\src\Nite.Cli\Nite.Cli.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <NiteCliPath>$(MSBuildThisFileDirectory)..\..\src\Nite.Cli\bin\$(Configuration)\net10.0\Nite.Cli.dll</NiteCliPath>
  </PropertyGroup>

  <Import Project="..\..\build\Nite.targets" />

</Project>
